    {
      "parameters": {
        "jsCode": "const upload = $('Upload Document').first().json.body || {};\nconst pages = Array.isArray($json.pages) ? $json.pages : [];\nconst rawText = pages\n  .map((page) => page?.markdown || page?.text || '')\n  .filter(Boolean)\n  .join('\\n\\n');\n\nconst normalizedText = String(rawText || '')\n  .replace(/```[\\s\\S]*?```/g, ' ')\n  .replace(/\\s+/g, ' ')\n  .trim();\n\nconst excerpt = normalizedText.slice(0, 6000);\n\nreturn [{\n  json: {\n    file_name: upload.file_name || '',\n    kategori: upload.kategori || '',\n    classification_excerpt: excerpt,\n    classification_prompt: `Anda adalah pengklasifikasi jenis dokumen internal perusahaan.\\n\\nTugas Anda: pilih tepat satu label dari daftar berikut untuk dokumen ini:\\n- sop\\n- policy\\n- report\\n- notulen\\n- proposal\\n- kontrak\\n- panduan\\n- other\\n\\nAturan mutlak:\\n1. Balas hanya satu kata label dari daftar di atas.\\n2. Jangan beri penjelasan tambahan.\\n3. Jika isi dokumen tidak cukup jelas atau campuran, balas other.\\n\\nNama file: ${upload.file_name || '-'}\\nKategori sumber: ${upload.kategori || '-'}\\n\\nCuplikan awal dokumen:\\n${excerpt || '[kosong]'}`\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        576
      ],
      "id": "e3b4130c-5636-4020-8d91-e2ab9c2a0167",
      "name": "Build Document Classification Excerpt"
    },
    {
      "parameters": {
        "jsCode": "const allowed = new Set(['sop', 'policy', 'report', 'notulen', 'proposal', 'kontrak', 'panduan', 'other']);\nconst raw = String($json.text || $json.response || $json.output || '')\n  .trim()\n  .toLowerCase();\nconst firstToken = raw.split(/[^a-z_]+/).find(Boolean) || '';\nconst documentType = allowed.has(firstToken) ? firstToken : 'other';\n\nreturn [{\n  json: {\n    document_type: documentType\n  }\n}];"
      },
