        "jsCode": "const item = $input.first();\nconst mergedJson = item.json || {};\nconst row = $('Create a row').first().json || {};\nconst upload = $('Upload Document').first().json.body || {};\n\nreturn [{\n  json: {\n    ...mergedJson,\n    document_id: row.id || row.document_id || null,\n    user_id: row.user_id || upload.user_id || null,\n    session_id: row.session_id || upload.session_id || null,\n    nama_file: row.nama_file || upload.file_name || null,\n    kategori: row.kategori || upload.kategori || null,\n    file_url: row.file_url || null,\n    document_type: row.document_type || mergedJson.document_type || 'other',\n  },\n  binary: item.binary,\n}];"
