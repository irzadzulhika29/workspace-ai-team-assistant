{
  "name": "team-assistant-workspace",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "fe",
    "be"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:fe\" \"npm run dev:be\"",
    "dev:fe": "npm run dev --workspace fe",
    "dev:be": "npm run dev --workspace be",
    "dev:client": "npm run dev:fe",
    "dev:server": "npm run dev:be",
    "build": "npm run build --workspace fe",
    "start": "npm run start --workspace be",
    "lint": "npm run lint --workspace fe && npm run lint --workspace be",
    "preview": "npm run preview --workspace fe",
    "prepare": "husky",
    "prisma:generate": "npm run prisma:generate --workspace be",
    "prisma:migrate": "npm run prisma:migrate --workspace be",
    "prisma:studio": "npm run prisma:studio --workspace be"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix --max-warnings 0"
    ]
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "nodemon": "^3.1.9",
    "postcss": "^8.4.38",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.4",
    "vite": "^5.2.12"
  }
}
